# Environment variables override files; dox_agent/.env overrides repository .env.
# Existing DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_BASE_URL also work.
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-me

# mineru api key  
MINERU_API_KEY=

# Empty means BM25 only. Set a concrete model folder, not its parent.
EMBEDDING_PATH=
# EMBEDDING_PATH=E:/local_models/embedding/Qwen--Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PROMPT=

# For local OpenAI-compatible servers:
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=your-tool-calling-model
# MODEL_API_KEY=local

WEB_PROVIDER=crawl4ai
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# WEB_SESSIONS_FILE=/absolute/path/dox_agent/.sessions/hosts.json

# PDF 解析改用 mineru（auto）：入库 full.md，预览 origin.pdf
# MINERU_CMD=mineru -p "{pdf}" -o "{out}" -m auto
# MINERU_OUTPUT_SUFFIX=  # 可选：mineru 输出目录后缀/位置覆盖
MAX_RESEARCH_STEPS=24
MAX_ROUNDS=2
# Set false to compare against the legacy nonempty-evidence route.
EVIDENCE_ROUTING=true
MAX_SEARCHES=6
MAX_READS=8
MAX_MODEL_CALLS=12
RESEARCH_TIMEOUT=180
RUN_TIMEOUT=360

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dox-agent
# LANGSMITH_API_KEY=

# Defaults resolve from the repository directory, not the working directory.
# 方案 A：CORPORA_ROOT 下每个直接子目录 = 一个自包含知识库
#        （库内固定 source/ + datadb/ + vectordb/）
# CORPORA_ROOT=/absolute/path/dox_agent/.knowledge
# KNOWLEDGE_ROOT=/absolute/path/dox_agent/.knowledge
# TEXT_ROOT=/absolute/path/dox_agent/.knowledge
# 活动（默认）库的 sqlite 与向量库；也可指向 .knowledge 之外的演示库
# DATA_DIR=/absolute/path/dox_agent/.demo_langchain/datadb
# VECTORDB_DIR=/absolute/path/dox_agent/.demo_langchain/vectordb
# 应用级状态目录（会话/笔记 workspace.sqlite3），独立于活动库
# STATE_DIR=/absolute/path/dox_agent/data

# Simple source questions may start with one bounded verification pass.
QUICK_VERIFICATION=true
