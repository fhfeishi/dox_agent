# Exported environment variables override this file.
# The parent directory's .env is no longer read automatically (F6/Q4, 2026-10-19); to use a shared
# file, set DOX_ENV_FILE=/absolute/path/.env (this project .env still wins). See .logsdev/cleanup-log.md.
# Existing DEEPSEEK_API_KEY / DEEPSEEK_MODEL / DEEPSEEK_BASE_URL also work.
# DeepSeek retired deepseek-chat on 2026-07-24; use a current model name.
MODEL_NAME=deepseek-v4-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=xxxxxxx--replace-me--xxxxxxxxxxx

# 模型调用是否走系统代理（HTTPS_PROXY 等环境变量）；默认直连；仅当网络必须经代理时设为 true。
MODEL_USE_PROXY=false

# ---- 本地 CLI（已定稿）：mineru-kit；云端 API 未采用 ----
# 已删除 MINERU_API_KEY（F4/Q3，2026-10-19）：没有代码读取。见 .logsdev/cleanup-log.md。

# Empty means BM25 only. Set a concrete model folder, not its parent.
EMBEDDING_PATH=xxxxxxx--replace-me--xxxxxxxxxxx
# EMBEDDING_PATH=E:/local_models/embedding/Qwen--Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PROMPT=

# For local OpenAI-compatible servers:
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=your-tool-calling-model
# MODEL_API_KEY=local

WEB_PROVIDER=crawl4ai
# FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# WEB_SESSIONS_FILE=/absolute/path/dox_agent/.sessions/hosts.json

# ---- K13：mineru PDF 解析（外部 CLI；未安装时 PDF 导入会报错）----
# 正文取 mineru 输出、页码取 page_idx，预览服务源 PDF。命令须含 {pdf} 与 {out}。
# MINERU_CMD=mineru-kit parse "{pdf}" -o "{out}" --tier standard --ocr-mode auto --format zip
# MINERU_TIMEOUT=3600  # 单份 PDF 解析超时（秒），scan 件较慢
# MINERU_HOME=/absolute/path/mineru-home  # 模型缓存目录
# 已删除 MAX_RESEARCH_STEPS、MAX_ROUNDS、EVIDENCE_ROUTING、MAX_SEARCHES、MAX_READS、RESEARCH_TIMEOUT
#（F4/Q3，2026-10-19）：旧研究循环的开关，现在没有代码读取，改了也不生效。见 .logsdev/cleanup-log.md。
MAX_MODEL_CALLS=12
RUN_TIMEOUT=360

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dox-agent
# LANGSMITH_API_KEY=

# 审查模型（可选）：不填则复用上面的 MODEL_*；写在 .env 里或在终端 export 都生效，export 的优先。
# REVIEW_MODEL_API_KEY=
# REVIEW_MODEL_BASE_URL=
# REVIEW_MODEL_NAME=
# REVIEW_MODEL_TIMEOUT=180       # 单次调用超时（秒，10–300）
# REVIEW_RUN_TIMEOUT=900         # 一次审查总时长（秒，60–1800）
# REVIEW_MAX_CALLS=32            # 一次审查最多调用次数（5–60）
# REVIEW_CHUNK_CHARS=12000
# REVIEW_MAX_DOCUMENT_CHARS=240000
# REVIEW_MAX_OUTPUT_TOKENS=16000

# Defaults resolve from the repository directory, not the working directory.
# §10：所有本地持久化只在 CORPORA_ROOT（默认 <repo>/.knowledge）下
# CORPORA_ROOT=/absolute/path/dox_agent/.knowledge
# 已弃用兼容项：新会话与省略范围的旧 API 均按实际子目录名字典序选首库；此值不再决定顺序。
# 应用级状态目录（会话/报告/显示名覆盖）；默认 <CORPORA_ROOT>/.state
# STATE_DIR=/absolute/path/dox_agent/.knowledge/.state

# 已删除 QUICK_VERIFICATION（F4/Q3，2026-10-19）：对应的配置项和 src/agent/quick.py 都已不存在。见 .logsdev/cleanup-log.md。
