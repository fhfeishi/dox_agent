CLAUDE.md
.env
.venv/
.sessions/
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
temp/
.inputs/
.input/
.output/
.outputs/

# 编辑器设置按机器各自保存：Windows 解释器在 .venv\Scripts\python.exe，WSL/Linux 在 .venv/bin/python。
.vscode/
# 规则、检查与本机 skill 仍不入库。产品专家资产（.agents/experts/）入库。
.agents/*
!.agents/experts/
data/
.workbuddy/*
# .knowledge：跟踪新 clone 直接可用所需的资料与整理结果（各库 source/parsed/archive/datadb、
# hierarchy.json、lineage*.json）；运行状态、按机器生成的向量索引与迁移快照不入库。
# .state 只保留库注册表 corpora.json（稳定 id 与显示名）。
.knowledge/.state/*
!.knowledge/.state/corpora.json
.knowledge/*/vectordb/
.knowledge/**/*.bak
.knowledge/**/*.pre-*
.knowledge/**/*Zone.Identifier
# 解析档案由 src/parse_cache.py 按机器生成（profile/version/written_at 随本机变化），不入库
.knowledge/**/parsed/**/cache.json


.data/*
.venv-win/
# Local reference template snapshot (104MB, incl. node_modules)
.logsdev/archive/*
!.logsdev/archive/2026-10-19-节点/
.logsdev/*.png

# Committed evaluation fixtures under tests/data/ (the generic data/ rule would ignore them)
!tests/data/

# Local administrator credentials and sessions
.local/

# Runtime logs written by each machine
service.log
*.log
# Kept locally, not tracked (user, 2026-10-20)
.logsdev/interactions/
.workbuddy/
.logsdev/design/资料库外置与数据分组实施方案.md

# Agent skill installs via `npx skills add`: 7 MB per skill and copied into every agent
# directory, so they stay local (user, 2026-10-21). Reinstall with
# `npx skills add JimLiu/baoyu-design -s baoyu-design -y --copy` when needed.
# 2026-11-13: `.claude/` held two agent worktrees (6.8 GB) plus a skills copy; the whole directory
# is local agent state, never part of the product. Worktrees are gone, the rule keeps them out.
.claude/
.hermes/
.kiro/
skills-lock.json


# Local MinerU models and its home (downloaded with modelscope, several GB; 资料库数据接口 E1)
/.models/
